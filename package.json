{
  "name": "andante",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "assets": "node scripts/assets.mjs",
    "build": "tsc --noEmit && node scripts/assets.mjs --check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/control.test.ts",
    "test:browser": "playwright test",
    "test:stability": "RUN_STABILITY=1 playwright test stability.spec.ts",
    "test:production": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "6.0.2",
    "vite": "8.3.4"
  }
}
